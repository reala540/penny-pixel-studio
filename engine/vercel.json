{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "feat/dashboard-reorg-b1": false } },
  "framework": null,
  "installCommand": "echo 'Static status page: no install needed'",
  "buildCommand": "echo 'Static status page: no build needed'",
  "outputDirectory": "status",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
